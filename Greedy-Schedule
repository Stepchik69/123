#include <iostream>
#include <set>
#include <vector>
#include <algorithm>

using namespace std;

// Функция для нахождения вершинного покрытия жадным алгоритмом
set<int> findMinimalCover(vector<pair<int, int>>& graphEdges) {
    set<int> vertexCover;
    vector<pair<int, int>> edgesList = graphEdges;
    
    // Нормализация ребер (упорядочивание вершин)
    for (auto& edge : edgesList) {
        if (edge.first > edge.second) {
            swap(edge.first, edge.second);
        }
    }
    
    // Пока есть непокрытые ребра
    while (!edgesList.empty()) {
        // Выбираем первое ребро из оставшихся
        auto currentEdge = edgesList[0];
        int vertexA = currentEdge.first;
        int vertexB = currentEdge.second;
        
        // Добавляем обе вершины в покрытие
        vertexCover.insert(vertexA);
        vertexCover.insert(vertexB);
        
        // Удаляем все ребра, инцидентные этим вершинам
        vector<pair<int, int>> newEdgesList;
        for (const auto& edge : edgesList) {
            // Проверяем, не инцидентно ли ребро выбранным вершинам
            if (edge.first != vertexA && edge.first != vertexB && 
                edge.second != vertexA && edge.second != vertexB) {
                newEdgesList.push_back(edge);
            }
        }
        edgesList = newEdgesList;
    }
    
    return vertexCover;
}

// Функция для проверки корректности покрытия
bool validateCover(const set<int>& cover, const vector<pair<int, int>>& edges) {
    for (const auto& edge : edges) {
        if (cover.find(edge.first) == cover.end() && 
            cover.find(edge.second) == cover.end()) {
            return false;
        }
    }
    return true;
}

int main() {
    vector<pair<int, int>> edges;
    int edgeCount;
    
    // Ввод данных
    cout << "Введите количество ребер в графе: ";
    cin >> edgeCount;
    
    cout << "Введите ребра (пары вершин от 0 до 9):" << endl;
    for (int i = 0; i < edgeCount; i++) {
        int u, v;
        cout << "Ребро " << i + 1 << ": ";
        cin >> u >> v;
        edges.push_back({u, v});
    }

    // Поиск вершинного покрытия
    set<int> resultCover = findMinimalCover(edges);

    // Вывод результатов
    cout << "\nРезультаты:" << endl;
    cout << "Размер вершинного покрытия: " << resultCover.size() << endl;
    cout << "Вершины в покрытии: ";
    for (int vertex : resultCover) {
        cout << vertex << " ";
    }
    cout << endl;

    // Проверка корректности
    bool isValid = validateCover(resultCover, edges);
    if (isValid) {
        cout << " Покрытие корректно - все ребра покрыты" << endl;
    } else {
        cout << " Ошибка: найдены непокрытые ребра" << endl;
    }

    return 0;
}
